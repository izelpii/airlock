{
  "_comment": [
    "Every image the compose install publishes, and how its compose layer is made.",
    "compose/README.md and documentation/specs/compose-install-spec.md section 3.2.",
    "",
    "source       the application's folder; its Dockerfile is built as the BASE, as is",
    "layer        anyuid  - entrypoint that runs as PUID:PGID (images whose user is appuser)",
    "             plain   - labels only (images that run as root and write no user data)",
    "             gateway - the compose gateway (compose/images/gateway)",
    "             certs   - built from compose/images/certs alone, no base",
    "home, owned  for anyuid: HOME, and the folders handed to PUID:PGID at start",
    "build_args   passed to the BASE build; {version} and {gallery_revision} are filled in",
    "platforms    what CI builds; deepface-gpu exists only for amd64",
    "fetch        files baked into the layer, checked by SHA-256, which nothing downloads at",
    "             runtime: YuNet (deploy.sh fetches it for the script install) and the pet",
    "             detector (tools/fetch_pet_weights.sh). A named volume mounted over the",
    "             folder starts as a copy of it, so the files land in the volume."
  ],
  "services": {
    "gateway":   {"source": "systems/gateway", "layer": "gateway"},
    "certs":     {"source": null, "layer": "certs"},
    "frontend":  {"source": "systems/frontend", "layer": "plain"},
    "backend":   {"source": "systems/backend", "layer": "anyuid",
                  "home": "/home/appuser", "owned": ["/home/appuser"],
                  "build_args": {"AIRLOCK_VERSION": "{version}"}},
    "deepface":  {"source": "systems/backend-deepface", "layer": "anyuid",
                  "home": "/home/appuser",
                  "owned": ["/home/appuser", "/app/uploads", "/app/database_images", "/app/data"],
                  "fetch": [{"url": "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx",
                            "sha256": "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4",
                            "dest": "/home/appuser/.deepface/weights/face_detection_yunet_2023mar.onnx"}]},
    "deepface-gpu": {"source": "systems/backend-deepface", "layer": "anyuid",
                  "home": "/home/appuser",
                  "owned": ["/home/appuser", "/app/uploads", "/app/database_images", "/app/data"],
                  "fetch": [{"url": "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx",
                            "sha256": "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4",
                            "dest": "/home/appuser/.deepface/weights/face_detection_yunet_2023mar.onnx"}],
                  "build_args": {"GPU": "1"}, "platforms": ["linux/amd64"],
                  "publish_as": "deepface", "tag_suffix": "-gpu"},
    "pets":      {"source": "systems/backend-pets", "layer": "anyuid",
                  "home": "/home/appuser", "owned": ["/home/appuser", "/app/weights"],
                  "fetch": [{"url": "https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_tiny.onnx",
                            "sha256": "427cc366d34e27ff7a03e2899b5e3671425c262ea2291f88bb942bc1cc70b0f7",
                            "dest": "/app/weights/yolox_tiny.onnx"}]},
    "vision":    {"source": "systems/backend-vision", "layer": "anyuid",
                  "home": "/home/appuser", "owned": ["/home/appuser"]},
    "geoloc":    {"source": "systems/backend-geoloc", "layer": "anyuid",
                  "home": "/home/appuser", "owned": ["/home/appuser", "/app"]},
    "transcode": {"source": "systems/backend-transcode", "layer": "anyuid",
                  "home": "/home/appuser", "owned": ["/home/appuser"],
                  "vendor": {"video_proxy.py": "systems/backend/workflows/lib/video_proxy.py"}},
    "albums":    {"source": "systems/backend-albums", "layer": "plain"},
    "gallery":   {"source": "systems/album-gallery", "layer": "plain",
                  "build_args": {"GALLERY_REVISION": "{gallery_revision}"}}
  }
}
