# Airlock Photos - compose install settings.
#
#   cp .env.example .env      (install.sh does this for you, and asks the questions)
#
# Only the first block MUST be set. Everything else has a working default.
# Advanced tuning (imports, faces, video, pets) goes in settings.env instead -
# see settings.env.example.

# ── Where your photos are ────────────────────────────────────────────────────
# The one folder Airlock may import from. Every storage route you add in the
# app must be inside it. Mounted read-write, so a "move" import can take files
# out of a route marked for it; set STORAGE_ROOT_MODE=ro to forbid that.
STORAGE_ROOT=/path/to/your/photos
#STORAGE_ROOT_MODE=rw

# Where Airlock keeps its own data. Back up CATALOGS_DIR and DATABASE_DIR.
CATALOGS_DIR=./data/catalogs        # every catalog: copies, thumbnails, albums
DATABASE_DIR=./data/database        # accounts, the catalog list, the secret key
INPUT_DIR=./data/IN                 # an inbox folder for imports
#LICENSE_DIR=./license              # where a license.json goes, if you have one
#CERTS_DIR=./certs                  # the HTTPS certificate and its CA

# ── This machine ─────────────────────────────────────────────────────────────
# Who owns the files Airlock writes: your user and group ids (`id -u`, `id -g`).
PUID=1000
PGID=1000

# This machine's address(es) on your network, comma-separated, so the HTTPS
# certificate is valid for https://<address>/. Find it with `hostname -I`
# (Linux) or System Settings > Network (Mac).
AIRLOCK_NAMES=

# The ports the gateway listens on. 443 is the one browsers use; 80 redirects.
#HTTP_PORT=80
#HTTPS_PORT=443

# ── Version ──────────────────────────────────────────────────────────────────
# An image tag: "latest" follows every release; a number (6.6.0) stays put
# until you change it here and run `docker compose pull && docker compose up -d`.
AIRLOCK_VERSION=latest
#AIRLOCK_IMAGES=ghcr.io/izelpii      # where the images come from

# ── Ollama (photo descriptions and album suggestions) ────────────────────────
# host.docker.internal: Ollama installed on this machine (the default, and the
# right choice on a Mac, where it uses the GPU). On Linux it must listen on all
# addresses: OLLAMA_HOST=0.0.0.0 in its service.
# ollama: Ollama in the stack - start with `docker compose --profile ollama up -d`.
OLLAMA_UPSTREAM=host.docker.internal
#OLLAMA_MODEL=gemma4:latest
#ALBUMS_LLM_MODEL=granite3.3:8b

# ── Optional ─────────────────────────────────────────────────────────────────
# A name of your own for the app, instead of airlock.lan.
#SERVER_DOMAIN=airlock.lan
# Origins beyond the address a page is loaded from (a DNS name, a reverse proxy).
#AIRLOCK_ALLOWED_ORIGINS=https://photos.example.com
# The gallery's session key. Unset, the gallery generates one and keeps it.
#ALBUM_SESSION_SECRET=
# Faces: how many workers (each holds about 600 MB) and whether to load the
# model at start.
#DEEPFACE_WORKERS=2
#DEEPFACE_WARMUP_EMBEDDER=1
#DEEPFACE_MODEL=VGG-Face
#YUNET_SCORE_THRESHOLD=0.9        # face detector cutoff; lower finds more faces
# The NVIDIA image for faces, with docker-compose.gpu.yml: DEEPFACE_VARIANT=-gpu
#DEEPFACE_VARIANT=
# Video previews: empty TRANSCODE_URL makes the import render them itself.
#TRANSCODE_URL=http://transcode:5004
# container (CPU), or gpu (set by docker-compose.gpu.yml).
#TRANSCODE_MODE=container
# Supplementary group ids for /dev/dri or /dev/video11 (README.md, "Hardware video").
#VIDEO_GIDS=
# Pets: detector input size (YOLOX-Tiny is fixed at 416) and parallel inferences.
#PETS_DETECT_SIZE=416
#PETS_CONCURRENCY=2
# What the certificate authority made for this installation is called.
#AIRLOCK_CA_LABEL=airlock
