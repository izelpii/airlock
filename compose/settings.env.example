# Advanced tuning, for the compose install. Optional.
#
#   cp settings.env.example settings.env      then uncomment what you need
#
# Each NAME=value is passed to the backend, faces, pets and video services, and
# only when it is here: a name left out means the application's own default.
# The same settings as deploy/airlock.env in the script install; the meanings
# are documented in documentation/features/ingestion-architecture.md (imports)
# and documentation/specs/accelerated-services-spec.md (faces and video).

# ── Imports ──────────────────────────────────────────────────────────────────
#AIRLOCK_INGEST_SCRIPT=io_picture_import_workflow.py   # the older, phased import
#IMPORT_READERS=1                 # fixed number of parallel reads; unset = adapt
#IMPORT_READ_CHUNK_MB=8
#IMPORT_META_CONCURRENCY=4
#IMPORT_RENDER_CONCURRENCY=3
#IMPORT_VIDEO_PRESET=veryfast
#IMPORT_VIDEO_NICE=10
#IMPORT_DEFER_VIDEO_RENDER=1      # video previews after every file is in
#IMPORT_RENDER_DURING_INGEST=0
#IMPORT_MOVE_RENAME=1

# ── Album transfers ──────────────────────────────────────────────────────────
#WORMHOLE_TRANSIT_RELAY=tcp:relay.example.org:4001

# ── Faces ────────────────────────────────────────────────────────────────────
#DEEPFACE_WARMUP_MODELS=VGG-Face,SFace

# ── Video previews ───────────────────────────────────────────────────────────
#TRANSCODE_JOBS=2
#TRANSCODE_ENCODER=auto           # libx264, h264_vaapi, h264_qsv, h264_nvenc, h264_v4l2m2m
#TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128
#TRANSCODE_V4L2_BITRATE=2500k
